{
  "rules": {
    "products": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52'"
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52'"
    },
    "orders": {
      ".read": "auth != null && auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52'",
      "$orderId": {
        ".read": "auth != null && (auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52' || data.child('user_uid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52' || data.child('user_uid').val() === auth.uid || !data.exists())"
      }
    },
    "users": {
      ".read": "auth != null && auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52')",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'Ag8XJGbIgQg2oNN84b417eoxkl52')"
      }
    }
  }
}
